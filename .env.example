# Headless AI Analyst ("Ask Your Data") configuration
# Copy this file to .env and configure ONE provider below. Never commit .env.

# Supported providers: gemini_api | gemini_cli | claude_cli
ANALYST_PROVIDER=gemini_api

# Option 1: Official Google GenAI Python SDK (default)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Option 2: Headless Gemini CLI subprocess (when ANALYST_PROVIDER=gemini_cli)
# GEMINI_CLI_BIN=gemini

# Option 3: Headless Claude Code CLI subprocess (when ANALYST_PROVIDER=claude_cli)
# CLAUDE_CLI_BIN=claude
